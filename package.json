{
  "name": "ptl-landing",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "description": "ptl.inc — the argument, drawn.",
  "scripts": {
    "dev": "python3 -m http.server 8777",
    "lint": "oxlint src",
    "deadcode": "knip",
    "dupes": "jscpd src --min-lines 12 --threshold 2 --reporters consoleFull",
    "verify": "pnpm lint && pnpm deadcode && pnpm dupes"
  },
  "devDependencies": {
    "jscpd": "^5.0.0",
    "knip": "^5.39.2",
    "oxlint": "^1.0.0"
  }
}
